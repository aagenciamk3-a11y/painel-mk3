{
  "rules": {
    "painel": {
      "estado": {
        ".read": true,
        ".write": true
      },

      "leads": {
        ".read": false,
        ".write": false
      },

      "comercial": {
        ".read":  "auth != null && auth.token.email_verified == true && root.child('painel/autorizados').child(auth.token.email.replace('.', ',').replace('@', '_')).val() == true",
        ".write": "auth != null && auth.token.email_verified == true && root.child('painel/autorizados').child(auth.token.email.replace('.', ',').replace('@', '_')).val() == true"
      },

      "autorizados": {
        ".read":  "auth != null && auth.token.email == 'aagencia.mk3@gmail.com'",
        ".write": "auth != null && auth.token.email == 'aagencia.mk3@gmail.com'",
        "$quem": { ".validate": "newData.isBoolean()" }
      },

      "publico": {
        "$token": {
          ".read": true,
          ".write": true,

          "crm": {
            "$lead": {
              ".validate": "newData.hasChildren()",
              "contato":    { ".validate": "newData.isBoolean()" },
              "semContato": { ".validate": "newData.isBoolean()" },
              "motivo":     { ".validate": "newData.isString() && newData.val().length <= 20" },
              "visita":     { ".validate": "newData.isBoolean()" },
              "venda":      { ".validate": "newData.isBoolean()" },
              "parceria":   { ".validate": "newData.isBoolean()" },
              "por":        { ".validate": "newData.isString() && newData.val().length <= 40" },
              "ts":         { ".validate": "newData.isString() && newData.val().length <= 40" },
              "$outro":     { ".validate": false }
            }
          }
        }
      }
    },

    ".read": false,
    ".write": false
  }
}
